{
  "name": "ghostshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One human. A team of AI agents. From idea to deployment.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run db:generate && next dev apps/console",
    "build": "npm run db:generate && tsc -p tsconfig.worker.json && next build apps/console",
    "start": "next start apps/console",
    "typecheck": "tsc --noEmit -p apps/console/tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "test:development": "node scripts/test-development.mjs",
    "test:sandbox": "node scripts/test-sandbox.mjs",
    "test:configuration": "node scripts/test-configuration.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
