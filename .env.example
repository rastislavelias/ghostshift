# Optional: docker compose works without creating this file.
# Bind locally; use an SSH tunnel to access a remote server.
GHOSTSHIFT_PORT=3000
# Local development credential. Database is not published to the host.
# Set this BEFORE the first start; changing it later does not rotate a stored DB password.
POSTGRES_PASSWORD=ghostshift-local-only

# Local planner. First startup downloads this model into the Ollama volume.
OLLAMA_MODEL=qwen3:4b
# Optional comma-separated allowlist; pull extra models into Ghostshift's Ollama first.
# OLLAMA_MODELS=qwen3:4b,another-installed-model
PLANNER_MAX_OUTPUT_TOKENS=2048
PLANNER_MAX_ATTEMPTS=2
PLANNER_TIMEOUT_SECONDS=240

# Optional paid providers. Keys stay on the server; model names must be configured.
# OPENAI_API_KEY=
# OPENAI_MODELS=
# COMPATIBLE_API_KEY=
# COMPATIBLE_BASE_URL=https://provider.example/v1
# COMPATIBLE_MODELS=

# Linux NVIDIA GPU: uncomment after installing NVIDIA Container Toolkit.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
